{
  "name": "ai-usage",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/ai-usage-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/ai-usage-tracker/issues"
  },
  "homepage": "https://github.com/your-org/ai-usage-tracker#readme",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build:cli": "pnpm --filter @ai-usage-tracker/cli... build",
    "start": "pnpm start:cli",
    "start:cli": "pnpm build:cli && pnpm --filter @ai-usage-tracker/cli start",
    "dev:cli": "pnpm build:cli && node scripts/run-parallel.mjs dev:cli:api dev:cli:ui",
    "dev:cli:api": "pnpm --filter @ai-usage-tracker/cli start",
    "dev:cli:ui": "VITE_API_TARGET=cli pnpm --filter @ai-usage-tracker/dashboard dev -- --open",
    "dev:web": "VITE_API_TARGET=cli pnpm --filter @ai-usage-tracker/dashboard dev",
    "dev:web:proxy": "VITE_API_TARGET=cli pnpm --filter @ai-usage-tracker/dashboard dev",
    "sync": "pnpm --filter @ai-usage-tracker/cli sync",
    "sync:pricing": "pnpm --filter @ai-usage-tracker/core sync:pricing",
    "dev:dashboard": "pnpm --filter @ai-usage-tracker/dashboard dev",
    "start:dashboard": "pnpm --filter @ai-usage-tracker/dashboard preview",
    "dev:desktop": "pnpm --filter \"@ai-usage-tracker/desktop^...\" build && pnpm --filter @ai-usage-tracker/desktop dev",
    "build:desktop": "pnpm --filter @ai-usage-tracker/desktop... build",
    "build:desktop:mac": "pnpm --filter \"@ai-usage-tracker/desktop^...\" build && pnpm --filter @ai-usage-tracker/desktop build:mac",
    "build:desktop:mac:arm": "pnpm --filter \"@ai-usage-tracker/desktop^...\" build && pnpm --filter @ai-usage-tracker/desktop build:mac:arm",
    "build:desktop:win": "pnpm --filter \"@ai-usage-tracker/desktop^...\" build && pnpm --filter @ai-usage-tracker/desktop build:win",
    "release:desktop:mac": "pnpm --filter \"@ai-usage-tracker/desktop^...\" build && pnpm --filter @ai-usage-tracker/desktop release:mac",
    "release:desktop:win": "pnpm --filter \"@ai-usage-tracker/desktop^...\" build && pnpm --filter @ai-usage-tracker/desktop release:win",
    "start:desktop": "pnpm --filter \"@ai-usage-tracker/desktop^...\" build && pnpm --filter @ai-usage-tracker/desktop start",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:cli && changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
